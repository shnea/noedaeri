# Actual values belong only in SOPS encrypted configuration.
DATABASE_URL=
WORKER_API_KEY=
WORKER_API_ORIGIN=
PUBLIC_ORIGIN=
STORAGE_ROOT=
API_BIND=
API_PORT=
PLATFORM_PROJECT_ID=
PLATFORM_ENVIRONMENT_ID=
PLATFORM_API_KEY=
PLATFORM_OIDC_ISSUER=
PLATFORM_OIDC_CLIENT_ID=
PLATFORM_OIDC_REDIRECT_URI=
OIDC_POST_LOGOUT_REDIRECT_URI=
ADMIN_OIDC_ISSUER=
ADMIN_OIDC_SUBJECT=

# Dedicated incoming platform credentials; distinct from PLATFORM_API_KEY above.
NOEDAERI_PLATFORM_API_KEY=
NOEDAERI_PLATFORM_WEBHOOK_URL=
NOEDAERI_PLATFORM_WEBHOOK_SECRET=
# Maximum unacknowledged result lifetime, seconds (default 604800).
PLATFORM_RESULT_TTL_SECONDS=

# Input file limit: default 5368709120 (5 GiB); temporary capacity: default 21474836480 (20 GiB).
UPLOAD_MAX_BYTES=
STORAGE_MAX_BYTES=

# Optional override: auto (default hardware first, CPU fallback), libx264, h264_videotoolbox.
FFMPEG_VIDEO_ENCODER=
