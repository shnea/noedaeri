# Actual values belong only in SOPS encrypted configuration.
DATABASE_URL=
WORKER_API_KEY=
WORKER_API_ORIGIN=
PUBLIC_ORIGIN=
STORAGE_ROOT=
API_BIND=
API_PORT=
PLATFORM_PROJECT_ID=
PLATFORM_ENVIRONMENT_ID=
PLATFORM_API_KEY=
PLATFORM_OIDC_ISSUER=
PLATFORM_OIDC_CLIENT_ID=
PLATFORM_OIDC_REDIRECT_URI=
OIDC_POST_LOGOUT_REDIRECT_URI=
ADMIN_OIDC_ISSUER=
ADMIN_OIDC_SUBJECT=

# Dedicated incoming platform credentials; distinct from PLATFORM_API_KEY above.
NOEDAERI_PLATFORM_API_KEY=
NOEDAERI_PLATFORM_WEBHOOK_URL=
NOEDAERI_PLATFORM_WEBHOOK_SECRET=
# Maximum unacknowledged result lifetime, seconds (default 604800).
PLATFORM_RESULT_TTL_SECONDS=

# Input file limit: default 5368709120 (5 GiB); temporary capacity: default 21474836480 (20 GiB).
UPLOAD_MAX_BYTES=
STORAGE_MAX_BYTES=

# Optional override: auto (default hardware first, CPU fallback), libx264, h264_videotoolbox.
FFMPEG_VIDEO_ENCODER=

# Dedicated n8n routing key; never reuse platform or worker credentials.
RAYA_ENABLED=
NOEDAERI_RAYA_API_KEY=
RAYA_MODEL_ROOT=
RAYA_MINIMUM_KEEP_SECONDS=
RAYA_IDLE_SECONDS=
RAYA_WAIT_SECONDS=
RAYA_TIMEOUT_SECONDS=
RAYA_MEMORY_RESERVE_BYTES=
# n8n management connection; keep actual values in encrypted n8n config.
N8N_ORIGIN=
N8N_RAYA_WORKFLOW_ID=
N8N_RAYA_CREDENTIAL_ID=

# Native TTS: per-job model process, bounded wait and generation.
TTS_ENABLED=
TTS_TIMEOUT_SECONDS=
TTS_MEMORY_LIMIT_BYTES=
NATIVE_COMPUTE_WAIT_SECONDS=
# Optional TTS override: outside STORAGE_ROOT; default SERVICE_STORAGE_ROOT/tts/voices.
VOICE_STORAGE_ROOT=
# Optional required NAS mount; refuse reference access if unmounted.
VOICE_STORAGE_MOUNT_ROOT=
# Common durable service root: service subfolders; default STATE_ROOT when unset.
SERVICE_STORAGE_ROOT=
SERVICE_STORAGE_MOUNT_ROOT=
# Optional SMB reconnect after user login; credentials stored only encrypted.
SERVICE_STORAGE_SMB_URL=
SERVICE_STORAGE_SMB_USERNAME=
SERVICE_STORAGE_SMB_PASSWORD=
VOICE_STORAGE_MAX_BYTES=
# n8n workflow forwards compute_context.token to internal HTTP steps; enable after verification.
N8N_COMPUTE_CONTEXT_READY=0

# Native offline STT: defaults 900 seconds, 3600 seconds of audio, 4 CPU threads.
STT_ENABLED=
STT_TIMEOUT_SECONDS=
STT_MAX_DURATION_SECONDS=
STT_CPU_THREADS=

# Native Apple Vision OCR: build helper first; processing timeout defaults to 120 seconds.
OCR_ENABLED=
OCR_TIMEOUT_SECONDS=
