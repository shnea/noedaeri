    {
      "id": "c63e6352-3911-542c-8e61-0bdac95d9bc0",
      "name": "샘플 요청 8종 + 미등록",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -480,
        560
      ],
      "parameters": {
        "jsCode": "// 분기 확인용 가상 요청입니다. 실제 입력을 연결할 때 이 노드를 교체하세요.\nconst samples = [\n  {\n    \"task_type\": \"blog.tags\",\n    \"prompt\": \"샘플 블로그 글에 태그를 붙여 주세요.\"\n  },\n  {\n    \"task_type\": \"blog.summary\",\n    \"prompt\": \"샘플 블로그 글을 요약해 주세요.\"\n  },\n  {\n    \"task_type\": \"portfolio.search\",\n    \"prompt\": \"샘플 포트폴리오에서 관련 내용을 찾아 주세요.\"\n  },\n  {\n    \"task_type\": \"ui.render\",\n    \"prompt\": \"샘플 UI 빌더에서 화면을 그려 주세요.\"\n  },\n  {\n    \"task_type\": \"comment.generate\",\n    \"prompt\": \"샘플 글의 댓글을 만들어 주세요.\"\n  },\n  {\n    \"task_type\": \"document.analyze\",\n    \"prompt\": \"샘플 문서를 분석해 주세요.\"\n  },\n  {\n    \"task_type\": \"code.analyze\",\n    \"prompt\": \"샘플 코드를 분석해 주세요.\"\n  },\n  {\n    \"task_type\": \"chat.general\",\n    \"prompt\": \"샘플 일반 질문입니다.\"\n  },\n  {\n    \"task_type\": \"future.task\",\n    \"prompt\": \"추가 작업 분기를 위한 샘플입니다.\"\n  }\n];\nreturn samples.map(json => ({ json }));"
      }
    },
